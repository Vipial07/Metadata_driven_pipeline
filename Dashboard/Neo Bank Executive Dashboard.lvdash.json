{
  "datasets": [
    {
      "name": "27ab0f31",
      "displayName": "Total_customer",
      "config": {
        "version": "1.1",
        "source": "select count(1) from banking.gold.customer_360",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "0b840378",
      "displayName": "total_deposite",
      "queryLines": [
        "select round(sum(total_balance),2) as total_deposite from banking.gold.customer_360;"
      ]
    },
    {
      "name": "08c43c19",
      "displayName": "total_transaction",
      "queryLines": [
        "select round(sum(total_transaction_amount),2) as total_transaction from banking.gold.customer_360 ;"
      ]
    },
    {
      "name": "55bd005d",
      "displayName": "High Risk Customer",
      "queryLines": [
        "select count(*) from banking.gold.customer_360 where risk_grade = 'HIGH'"
      ]
    },
    {
      "name": "17621b6c",
      "displayName": "transaction_channel_summary",
      "queryLines": [
        "select * from banking.gold.transaction_channnel_summary;"
      ]
    },
    {
      "name": "e6ba6045",
      "displayName": "based_on_customer_segment",
      "queryLines": [
        "select customer_segment,count(*) as count from banking.gold.customer_360 group by customer_segment;"
      ]
    },
    {
      "name": "717d47ab",
      "displayName": "based_on_risk_grade",
      "queryLines": [
        "select risk_grade,count(*) from banking.gold.customer_360 where risk_grade is not null group by risk_grade;\r\n",
        "\r\n",
        "\r\n",
        "-- select * from banking.bronze.credit_bureau_reports;-- where risk_grade is not null"
      ]
    },
    {
      "name": "774e2d64",
      "displayName": "top_customer",
      "queryLines": [
        "select customer_name, round(total_balance) as total_balance,branch_name,risk_grade from banking.gold.customer_360 order by total_balance desc limit 10; "
      ]
    },
    {
      "name": "7ef95c93",
      "displayName": "Customer_by_branch",
      "queryLines": [
        "select branch_performace.branch_name,total_customers from banking.gold.branch_performace;\n"
      ]
    },
    {
      "name": "085c36a3",
      "displayName": "branch_wise_total_deposite",
      "queryLines": [
        "select branch_code,round(total_deposits) as total_deposits  from banking.gold.branch_performace;"
      ],
      "catalog": "banking",
      "schema": "gold"
    },
    {
      "name": "f6db1e9f",
      "displayName": "top_5_business_date",
      "queryLines": [
        "SELECT\r\n",
        "    txn_date,\r\n",
        "    ROUND(SUM(total_transaction_amount)) AS total_transaction_amount\r\n",
        "FROM banking.gold.daily_bank_kpi\r\n",
        "GROUP BY txn_date\r\n",
        "ORDER BY total_transaction_amount desc\r\n",
        "LIMIT 5;"
      ],
      "catalog": "banking",
      "schema": "gold"
    },
    {
      "name": "107f93e7",
      "displayName": "transaction_summary",
      "queryLines": [
        "SELECT\r\n",
        "    txn_date,\r\n",
        "    ROUND(SUM(total_transaction_amount)) AS total_transaction_amount\r\n",
        "FROM banking.gold.daily_bank_kpi\r\n",
        "GROUP BY txn_date;"
      ],
      "catalog": "banking",
      "schema": "gold"
    }
  ],
